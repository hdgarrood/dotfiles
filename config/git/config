[user]
    name = Harry Garrood
    email = harry@garrood.me
[github]
    user = hdgarrood
[alias]
    co = checkout
    st = status
    ci = commit
    rm-submodule = "!f(){ git rm -rf \"$1\";git config -f .gitmodules --remove-section \"submodule.$1\";git config -f .git/config --remove-section \"submodule.$1\";git add .gitmodules; }; f"
[color]
    diff = auto
    status = auto
    branch = auto
[core]
    excludesfile = ~/.config/git/ignore
    autocrlf = input
[pull]
    rebase = true
[push]
    default = current
[format]
    pretty = %C(yellow)%h%Creset %s %C(red)(%an, %cr)%Creset
[web]
    browser = chromium-browser
[merge]
    conflictstyle = diff3
[init]
  defaultBranch = main
[rerere]
  enabled = true
  autoUpdate = true

[include]
  path = config.local
