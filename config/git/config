[user]
    name = Harry Garrood
    email = harry@garrood.me
[github]
    user = hdgarrood
[alias]
    co = checkout
    st = status
    ci = commit
    rm-submodule = "!f(){ git rm -rf \"$1\";git config -f .gitmodules --remove-section \"submodule.$1\";git config -f .git/config --remove-section \"submodule.$1\";git add .gitmodules; }; f"
[color]
    diff = auto
    status = auto
    branch = auto
[core]
    excludesfile = ~/.config/git/ignore
    autocrlf = input
[pull]
    rebase = true
[push]
    default = current
[format]
    pretty = %C(yellow)%h%Creset %s %C(red)(%an, %cr)%Creset
[web]
    browser = chromium-browser
[merge]
    conflictstyle = diff3
[init]
  defaultBranch = main
[rerere]
  enabled = true
  autoUpdate = true

# always push/pull over https; this allows using wifi that blocks port 22
[credential "https://github.com"]
  helper =
  helper = !/Users/harry/.nix-profile/bin/gh auth git-credential
[url "https://github.com/"]
  insteadOf = git@github.com:
[url "https://github.com/"]
  insteadOf = ssh://git@github.com/

[include]
  path = config.local

